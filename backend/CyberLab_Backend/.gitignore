
# ==========================================
# CYBERLAB - .gitignore
# ASP.NET Core / Rider / React / Docker
# ==========================================


# ==========================================
# 1. SECRETS & ENVIRONMENT VARIABLES
# ==========================================

.env
.env.*
!.env.example
!.env.*.example

# Local secrets and credentials
secrets/
**/secrets/
*.secret
*.secrets
*.pem
*.key
*.pfx
*.p12
*.snk

# ASP.NET Core user secrets (if stored locally)
**/secrets.json

# Local configuration overrides
**/appsettings.Local.json
**/appsettings.*.local.json


# ==========================================
# 2. .NET BUILD OUTPUT
# ==========================================

**/bin/
**/obj/
**/publish/
**/TestResults/

*.dll
*.exe
*.pdb
*.cache

# NuGet
*.nupkg
*.snupkg
**/packages/


# ==========================================
# 3. JETBRAINS RIDER
# ==========================================

.idea/
**/.idea/

*.sln.iml
*.sln.DotSettings.user
*.csproj.user
*.user
*.suo

# JetBrains local caches
_ReSharper*/
*.DotSettings.user


# ==========================================
# 4. VISUAL STUDIO / VS CODE
# ==========================================

.vs/
**/.vs/

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json


# ==========================================
# 5. FRONTEND / NODE.JS
# ==========================================

**/node_modules/
**/dist/
**/coverage/
**/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ==========================================
# 6. DATABASE & LOCAL DATA
# ==========================================

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Database backups and dumps
*.dump
*.bak
*.backup

# Local database storage
postgres_data/
pgdata/


# ==========================================
# 7. DOCKER
# ==========================================

docker-compose.override.yml
compose.override.yaml

# Local Docker configurations
docker-compose.local.yml
compose.local.yaml


# ==========================================
# 8. LOGS & TEMPORARY FILES
# ==========================================

*.log
logs/
**/logs/

*.tmp
*.temp
*.swp
*.swo
*~
*.orig
*.rej


# ==========================================
# 9. OPERATING SYSTEM
# ==========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*/ 


# ==========================================
# 10. TEST & COVERAGE OUTPUT
# ==========================================

coverage/
coverage-reports/
**/TestResults/

*.coverage
*.coveragexml
*.trx


# ==========================================
# 11. LOCAL DEVELOPMENT FILES
# ==========================================

*.local
*.local.json

# Temporary working directories
tmp/
temp/
.cache/
